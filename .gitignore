# Local Python / Conda environment
env/
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# PyInstaller and packaged output
build/
dist/
release/

# Local secrets: never commit the real API key
config/ai_settings.json
config/column_mapping.json

# Offline judgment-analysis Word output
outputword/

# Generated / case data (accident reports, annotations)
history/*
!history/.gitkeep

# Knowledge source tables, case packs, and leftovers stay local.
# Distilled playbook.json is tracked. ExampleTable.xlsx is the shipped format sample.
knowledge/**/*.xlsx
knowledge/**/*.xls
knowledge/**/*.tmp
knowledge/**/*.migrated
knowledge/index.json
knowledge/packs/
!knowledge/ExampleTable.xlsx

# YOLO weights exceed GitHub's 100MB file limit
downloads/*.pt
downloads/*.onnx
downloads/*.engine

# Chinese NER weights for offline desensitize
downloads/chinese_ner/**
!downloads/chinese_ner/.gitkeep

# Editor / OS
.cursor/
.idea/
.vscode/
*.swp
Thumbs.db
Desktop.ini
.DS_Store
